# Test environment variables for integration tests
# Uses free-tier SaaS services (Neon PostgreSQL + Upstash Redis)
# NOTE: For CI/remote testing, override with Upstash URL via env var:
#   REDIS_URL=rediss://default:AaLJAAIgcDFkOTdkZDhiZjY0YmQ0ZjNkYTg1OTc3Yjg4YmEyNzAwNA@desired-silkworm-41673.upstash.io:6379

# Node Environment - test mode so services can skip non-essential connections
NODE_ENV=test

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Neon PostgreSQL (test branch) - using pooler for application connections
DATABASE_URL=postgresql://neondb_owner:npg_yNcLaf7ovG9E@ep-falling-bar-ao8rcitk-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Neon PostgreSQL - direct connection for Prisma migrations (test branch)
DIRECT_URL=postgresql://neondb_owner:npg_yNcLaf7ovG9E@ep-falling-bar-ao8rcitk.c-2.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Redis: Use local Redis for fast local testing (override in CI with Upstash URL)
REDIS_URL=redis://localhost:6379

# MQTT (not used in integration tests, but needs a value)
MQTT_BROKER_URL=mqtt://localhost:1883

# Stripe (test mode - not used in most integration tests)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
